app = "your-kicktipp-agent"
primary_region = "fra"

[build]

[env]
  PORT = "8080"
  MCP_PATH = "/mcp"

[http_service]
  internal_port = 8080
  force_https = true
  # Browserless HTTP startup is cheap enough that the app can scale to zero.
  auto_stop_machines = "stop"
  auto_start_machines = true
  min_machines_running = 0

  [http_service.concurrency]
    type = "requests"
    soft_limit = 5
    hard_limit = 10

  [[http_service.checks]]
    interval = "30s"
    timeout = "5s"
    grace_period = "10s"
    method = "GET"
    path = "/health"

# Browserless HTTP sessions are lightweight; keep modest headroom for Node and
# concurrent MCP requests.
[[vm]]
  size = "shared-cpu-1x"
  memory = "256mb"
